+#[cfg(test)]
+fn prepare_terminal_rendering(_ctx: &egui::Context, _visible_panes: usize) {}
+
+const TERMINAL_RENDER_LOCK_BUDGET: Duration = Duration::from_micros(500);
+
+fn terminal_render_lock<T>(state: &std::sync::Mutex<T>) -> Option<std::sync::MutexGuard<'_, T>> {
+    let started = Instant::now();
+    loop {
+        match state.try_lock() {
+            Ok(guard) => return Some(guard),
+            Err(std::sync::TryLockError::WouldBlock) => {
+                if started.elapsed() >= TERMINAL_RENDER_LOCK_BUDGET {
+                    return None;
+                }
+                std::thread::yield_now();
+            }
+            Err(std::sync::TryLockError::Poisoned(_)) => return None,
+        }
+    }
 }
 
