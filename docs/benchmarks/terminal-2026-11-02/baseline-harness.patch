+#[test]
+#[ignore = "set TESSERA_BENCH_SOAK=1 for a bounded 256 MiB continuous session"]
+fn terminal_soak() {
+    if std::env::var_os("TESSERA_BENCH_SOAK").is_none() { return; }
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR"));
+    let temporary = tempfile::tempdir().unwrap();
+    let ack = temporary.path().join("ack");
+    let bytes = 256 * 1024 * 1024;
+    let terminal = Terminal::spawn_agent(
+        Uuid::new_v4(), root, std::path::Path::new("/tmp/tessera-bench-unused.sock"),
+        Context::default(), &format!("python3 '{}' soak {bytes} '{}'", root.join("tests/fixtures/terminal/workload.py").display(), ack.display()),
+    ).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(15);
+    while !marker(&terminal, "BENCH_READY") {
+        assert!(Instant::now() < deadline, "startup timeout");
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    let started = Instant::now();
+    let (initial_cpu, _) = resources();
+    terminal.input(b"s".to_vec()).unwrap();
+    std::thread::sleep(Duration::from_millis(10));
+    let input_started = Instant::now();
+    terminal.input(b"p".to_vec()).unwrap();
+    while !ack.exists() {
+        assert!(input_started.elapsed() < Duration::from_secs(5), "input acknowledgement timeout");
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    let input_ms = input_started.elapsed().as_secs_f64() * 1000.0;
+    let mut next_sample = 1;
+    loop {
+        if started.elapsed().as_secs() >= next_sample {
+            let (cpu, rss) = resources();
+            println!("SOAK seconds={} cpu_s={:.3} peak_rss_bytes={rss}", started.elapsed().as_secs(), cpu - initial_cpu);
+            assert!(rss < 512 * 1024 * 1024, "512 MiB process memory budget exceeded");
+            next_sample += 1;
+        }
+        if marker(&terminal, "BENCH_DONE") { break; }
+        assert!(started.elapsed() < Duration::from_secs(60), "soak time budget exceeded");
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    println!("SOAK_DONE bytes={bytes} elapsed_ms={:.2} input_ack_ms={input_ms:.2}", started.elapsed().as_secs_f64() * 1000.0);
+}
